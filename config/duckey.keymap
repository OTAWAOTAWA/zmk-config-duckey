#define ZMK_POINTING_DEFAULT_SCRL_VAL 200


#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define FUNCTION 1
#define NUMBER 2
#define SCROLL 3
#define MOUSE 4

&mt {
    tapping-term-ms = <300>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <0>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <0 4>;
            layers = <3>;
        };

        bootloader {
            bindings = <&bootloader>;
            key-positions = <1 2 3>;
            layers = <3>;
        };
    };

    behaviors {
        encoder_msc: sensor_rotate_msc {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;
            tap-ms = <20>;
        };

        encoder_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            bindings = <
&kp Q             &kp W         &kp E         &kp R  &kp T                                      &kp Y        &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &lt 3 D       &kp F  &kp G                                      &kp H        &kp J  &lt 3 K    &kp L    &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V  &kp B                                      &kp N        &kp M  &kp COMMA  &kp DOT  &mt RIGHT_SHIFT SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &none  &lt 1 SPACE  &lt 3 TAB    &kp BACKSPACE   &lt 2 ENTER         &kp ESC    &kp ESC
            >;

            sensor-bindings = <&encoder_msc SCRL_DOWN SCRL_UP>;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&kp F1     &kp F2           &kp F3     &kp F4                 &kp F5                                &kp F6          &kp F7    &kp F8    &kp F9     &kp F10
&kp COLON  &kp EXCLAMATION  &kp SLASH  &kp LEFT_PARENTHESIS   &kp LEFT_BRACKET                      &kp UNDERSCORE  &mkp MB1  &kp UP    &mkp MB2   &kp SEMICOLON
&trans     &kp QUESTION     &kp BSLH   &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET                     &kp AT_SIGN     &kp LEFT  &kp DOWN  &kp RIGHT  &kp F11
&trans     &trans           &trans     &trans                 &trans            &trans    &trans    &trans          &trans     &kp F12
            >;
        };

        number_layer {
            display-name = "Number";
            bindings = <
&kp TAB               &kp N7        &kp N8        &kp N9        &kp MINUS                          &kp RBKT   &trans    &mkp MB3  &trans     &trans
&kp ASTERISK          &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp PLUS                           &kp RPAR   &mkp MB1  &kp UP    &mkp MB2   &kp COLON
&mt LEFT_SHIFT SLASH  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL                          &kp RBRC   &kp LEFT  &kp DOWN  &kp RIGHT  &kp SLASH
&kp ESCAPE            &kp N0        &kp PERIOD    &trans        &kp LANG2     &kp DEL    &trans    &kp LANG1       &trans     &kp F12
            >;

            sensor-bindings = <&encoder_kp C_VOL_UP C_VOL_DN>;
        };

        scroll_layer {
            display-name = "Scroll";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                    &kp LC(LG(LEFT))  &kp LG(TAB)  &mkp MB3  &trans     &kp LG(LC(RIGHT))
&trans        &trans        &trans        &trans        &trans                          &mkp MB4          &mkp MB1     &kp UP    &mkp MB2   &mkp MB5
&trans        &trans        &trans        &trans        &trans                          &trans            &kp LEFT     &kp DOWN  &kp RIGHT  &trans
&trans        &trans        &trans        &trans        &trans        &trans    &trans  &trans          &trans     &bt BT_CLR_ALL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &mkp MB3  &trans    &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans    &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans     &trans
            >;
        };
    };
};
